[Unit]
Description=Cypher Robot Dashboard
After=network.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=sentry
Group=sentry
WorkingDirectory=/home/sentry/cypher-dashboard

# Use the virtual environment's Python
Environment="PATH=/home/sentry/cypher-dashboard/venv/bin"
EnvironmentFile=-/home/sentry/cypher-dashboard/.env

# Explicit environment variables (will be overridden by .env if present)
Environment="CYPHER_STREAM_URL=http://cypher:8080/stream"
Environment="CYPHER_CONTROL_URL=http://sentrybot.local"

ExecStart=/home/sentry/cypher-dashboard/venv/bin/python -m flask --app app run --host=0.0.0.0 --port=5000

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
