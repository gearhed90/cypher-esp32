# Cypher Dashboard Environment Configuration
# Copy this file to .env and edit the values.

CYPHER_STREAM_URL=http://cypher:8080/stream

# Serial port used by ESP32Bridge (default is the Pi UART)
CYPHER_SERIAL_PORT=/dev/serial0
CYPHER_SERIAL_BAUD=115200

# Pan / tilt on Pi (BCM numbering)
CYPHER_PAN_GPIO=18
CYPHER_TILT_GPIO=17
# Optional angle limits (degrees)
# CYPHER_PAN_MIN=-90
# CYPHER_PAN_MAX=90
# CYPHER_TILT_MIN=-45
# CYPHER_TILT_MAX=45

# Optional
# DASHBOARD_TITLE=Cypher
